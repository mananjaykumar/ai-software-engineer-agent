# Application
PROJECT_NAME="AI Software Engineer Agent"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=agent_core

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here

# GitHub App
GITHUB_WEBHOOK_SECRET=mock_webhook_secret_for_dev
GITHUB_APP_ID=mock_app_id
GITHUB_PRIVATE_KEY=mock_private_key_for_dev



